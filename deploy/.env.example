# 复制为同目录 deploy/.env 后按需修改：cp deploy/.env.example deploy/.env
# deploy/.env 含敏感口令，已被 .gitignore 排除，切勿提交。

# PostgreSQL 口令（容器内数据库 a3）
A3_POSTGRES_PASSWORD=a3-change-me

# 控制台种子管理员（服务端首次启动时创建；必填，否则容器拒绝启动）
A3_ADMIN_USER=admin
A3_ADMIN_PASSWORD=

# 控制台登录态签名密钥；留空则每次重启随机生成(所有用户需重新登录)，生产建议显式设置
A3_JWT_SECRET=

# 对外暴露端口。服务端默认仅绑定本机回环 127.0.0.1（见下方说明），
# 除非明确在反代/防火墙开放，否则局域网内不可达。
A3_HTTP_PORT=8080

# 终端设备自助注册开关。默认关闭：注册端点对未知设备返回 403，需先登记设备令牌。
# 单机快速上手可开一行 A3_ALLOW_AUTO_REGISTER=true；生产接入走「开—登记—关」流程。
A3_ALLOW_AUTO_REGISTER=false

# 可选 HTTPS：同时设置证书与私钥路径才走 ListenAndServeTLS（仅设其一服务端拒绝启动）。
# 二进制直跑时给本机 PEM 路径；容器部署建议反代终 TLS 或挂载证书后注入容器内路径。
A3_TLS_CERT=
A3_TLS_KEY=
