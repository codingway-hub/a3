# 复制为同目录 deploy/.env 后按需修改：cp deploy/.env.example deploy/.env
# deploy/.env 含敏感口令，已被 .gitignore 排除，切勿提交。

# PostgreSQL 口令（容器内数据库 a3）
A3_POSTGRES_PASSWORD=a3-change-me

# 控制台种子管理员（服务端首次启动时创建；必填，否则容器拒绝启动）
A3_ADMIN_USER=admin
A3_ADMIN_PASSWORD=

# 控制台登录态签名密钥；留空则每次重启随机生成(所有用户需重新登录)，生产建议显式设置
A3_JWT_SECRET=

# 对外暴露端口。服务端默认仅绑定本机回环 127.0.0.1（见下方说明），
# 除非明确在反代/防火墙开放，否则局域网内不可达。
A3_HTTP_PORT=8080

# 服务端监听绑定。install-server.sh 检测到非回环公开地址时会自动改为 0.0.0.0；
# 手动部署保持默认回环更安全，需局域网可达时再放开。
A3_HTTP_BIND=127.0.0.1

# 对外公开地址（含端口，如 http://aa.bb.com:12345）。install-server.sh 自动写入。
# 决定 install.sh 注入的服务端地址与控制台「接入指南」页展示的命令；反代场景配置即权威。
A3_PUBLIC_URL=

# 采集器发布产物目录（提供 /download/agent/ 下载）。容器部署镜像内已内置（/app/agent）
# 无需设置；二进制直跑时指向 make release-agent 产物目录 bin/release。
A3_AGENT_DIST=

# 终端设备自助注册开关。install-server.sh 一键安装会自动改为 true（收齐设备后建议改回）；
# 手动部署保持 false 更安全：注册端点对未开放时的新设备返回 403，需先登记设备令牌。
A3_ALLOW_AUTO_REGISTER=false

# 告警通知外送 webhook 地址（空=禁用）。填入后告警每分钟聚合外送一条摘要，
# 覆盖 Slack 兼容收端 / 企业微信群机器人 / 钉钉群机器人 / 飞书群机器人。
# 注意：钉钉机器人「加签」安全模式不支持，请用关键词或 IP 白名单模式。
A3_NOTIFY_WEBHOOK_URL=
# webhook 信封格式：generic（默认，顶层 text 兼容 Slack）、wecom、dingtalk、feishu
A3_NOTIFY_WEBHOOK_FORMAT=generic
# 外送最低严重级别：low（默认，全部）、medium、high。外送为 at-least-once，控制台为准。
A3_NOTIFY_MIN_SEVERITY=

# 可选 HTTPS：同时设置证书与私钥路径才走 ListenAndServeTLS（仅设其一服务端拒绝启动）。
# 二进制直跑时给本机 PEM 路径；容器部署建议反代终 TLS 或挂载证书后注入容器内路径。
A3_TLS_CERT=
A3_TLS_KEY=
